---
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/config";
import Footer from "@/components/Footer.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getLocaleFromPath, localeMeta, ui, type Locale } from "@/i18n";
import "@/styles/global.css";

type StructuredDataType = "BlogPosting" | "CollectionPage" | "WebPage";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  structuredDataType?: StructuredDataType;
  structuredData?: Record<string, unknown> | null;
  locale?: Locale;
  /** hreflang 配对，仅传入确实存在对应译文的页面 */
  alternates?: { hreflang: string; href: string }[];
};

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];
const meta = localeMeta[locale];

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = copy.site.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  structuredDataType = pubDatetime ? "BlogPosting" : "WebPage",
  structuredData,
  alternates = [],
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);
const canonicalHref = canonicalURL.toString();
const ogType = structuredDataType === "BlogPosting" ? "article" : "website";
const person = {
  "@type": "Person",
  name: `${author}`,
  ...(profile && { url: profile }),
};

const baseStructuredData =
  structuredDataType === "BlogPosting"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: `${title}`,
        description: `${description}`,
        image: `${socialImageURL}`,
        url: canonicalHref,
        inLanguage: meta.htmlLang,
        datePublished: pubDatetime?.toISOString(),
        ...(modDatetime && { dateModified: modDatetime.toISOString() }),
        author: [person],
      }
    : {
        "@context": "https://schema.org",
        "@type": structuredDataType,
        name: `${title}`,
        description: `${description}`,
        url: canonicalHref,
        image: `${socialImageURL}`,
        inLanguage: meta.htmlLang,
        isPartOf: {
          "@type": "WebSite",
          name: SITE.title,
          url: SITE.website,
        },
        author: [person],
      };

const resolvedStructuredData = structuredData
  ? { ...baseStructuredData, ...structuredData }
  : baseStructuredData;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={meta.htmlLang}
  class={scrollSmooth ? "scroll-smooth" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/avif"
      sizes="any"
      href="/favicon.avif?v=20260721"
    />
    <link rel="icon" type="image/png" href="/favicon.png?v=20260812" />

    <slot name="head" />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="63f34637-df53-4bc9-9a3f-d0908d2931b3"></script>
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="fediverse:creator" content="renata@dvd.chat" />
    <link rel="me" href="https://dvd.chat/@renata" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      structuredDataType === "BlogPosting" && pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      structuredDataType === "BlogPosting" && modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(resolvedStructuredData)}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === "en" ? `${SITE.title} (English)` : SITE.title}
      href={new URL(
        locale === "en" ? "en/rss.xml" : "rss.xml",
        Astro.site
      )}
    />

    <meta name="theme-color" content="" />

    <script is:inline>
      (function () {
        const shouldSkip = sessionStorage.getItem("skipViewTransition");
        if (shouldSkip) {
          document.documentElement.classList.add("skip-view-transition");
        }

        document.addEventListener("astro:page-load", () => {
          if (!shouldSkip) return;
          sessionStorage.removeItem("skipViewTransition");
          document.documentElement.classList.remove("skip-view-transition");
        });
      })();
    </script>

    <ClientRouter />

    <script is:inline>
      (function () {
        const initialColorScheme = "";
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <!-- 键盘用户按 Tab 的第一站：直接跳过顶栏和导航 -->
    <a href="#main-content" class="skip-link">{copy.nav.skipToContent}</a>
    <div class="flex-1"><slot /></div>
    <Footer />
    <div
      class="fixed right-4 bottom-8 z-50 flex flex-col items-center gap-4 sm:right-8"
    >
      <BackToTopButton />
      <slot name="floating" />
    </div>

    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/back-button-fallback.ts"></script>
    <script is:inline>
      const POST_MEMORY_KEY = "postLinkMemory";
      const POST_MEMORY_INIT_KEY = "__postLinkMemoryInit";

      function normalizePath(pathname, search = "") {
        const normalizedPath =
          pathname.length > 1 && pathname.endsWith("/")
            ? pathname.slice(0, -1)
            : pathname;
        return `${normalizedPath}${search}`;
      }

      function getCurrentPath() {
        return normalizePath(window.location.pathname, window.location.search);
      }

      function getListMemoryScope() {
        return document.querySelector("[data-post-memory-scope]");
      }

      function isRememberablePostLink(link) {
        if (!(link instanceof HTMLAnchorElement)) return false;

        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return false;

        const currentUrl = new URL(window.location.href);
        const isSameDocumentLink =
          url.pathname === currentUrl.pathname &&
          url.search === currentUrl.search &&
          url.hash;

        if (isSameDocumentLink) return false;

        return (
          link.hasAttribute("data-post-link") ||
          url.pathname.startsWith("/posts/")
        );
      }

      function rememberPostLinkPosition(event) {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        if (!getListMemoryScope()) return;

        const target =
          event.target instanceof Element
            ? event.target
            : event.target?.parentElement;
        const link = target?.closest("a[href]");
        if (!(link instanceof HTMLAnchorElement)) return;
        if (!isRememberablePostLink(link)) return;

        const url = new URL(link.href, window.location.href);

        sessionStorage.setItem(
          POST_MEMORY_KEY,
          JSON.stringify({
            listPath: getCurrentPath(),
            postPath: normalizePath(url.pathname, url.search),
            viewportTop: link.getBoundingClientRect().top,
            scrollY: window.scrollY,
          })
        );
      }

      function restorePostLinkPosition() {
        if (!getListMemoryScope()) return;

        const raw = sessionStorage.getItem(POST_MEMORY_KEY);
        if (!raw) return;

        try {
          const memory = JSON.parse(raw);
          if (memory?.listPath !== getCurrentPath()) return;

          document.documentElement.classList.add("is-restoring-scroll");

          const links = Array.from(document.querySelectorAll("a[href]")).filter(
            link => isRememberablePostLink(link)
          );
          const matchingLink = links.find(link => {
            if (!(link instanceof HTMLAnchorElement)) return false;
            const url = new URL(link.href, window.location.href);
            return normalizePath(url.pathname, url.search) === memory.postPath;
          });

          const targetTop =
            matchingLink instanceof HTMLElement
              ? window.scrollY +
                matchingLink.getBoundingClientRect().top -
                Number(memory.viewportTop ?? 0)
              : Number(memory.scrollY ?? 0);

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              window.scrollTo({
                top: Math.max(0, targetTop),
                left: 0,
                behavior: "instant",
              });
              requestAnimationFrame(() => {
                document.documentElement.classList.remove(
                  "is-restoring-scroll"
                );
              });
            });
          });

          sessionStorage.removeItem(POST_MEMORY_KEY);
        } catch {
          sessionStorage.removeItem(POST_MEMORY_KEY);
          document.documentElement.classList.remove("is-restoring-scroll");
        }
      }

      if (!window[POST_MEMORY_INIT_KEY]) {
        document.addEventListener("click", rememberPostLinkPosition);
        document.addEventListener("astro:page-load", restorePostLinkPosition);
        window[POST_MEMORY_INIT_KEY] = true;
      }

      restorePostLinkPosition();
    </script>
  </body>
</html>

<style>
  /* 跳到正文：平时移出视口，聚焦时滑进来。
     不用 sr-only / not-sr-only 组合 —— 两者都写 position，靠源码顺序决胜，容易翻车。 */
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 60;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--background);
    color: var(--foreground);
    font-size: 14px;
    line-height: 1.4;
    transform: translateY(-200%);
    transition: transform 0.18s ease;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
