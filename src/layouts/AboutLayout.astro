---
import type { MarkdownLayoutProps } from "astro";
import ArtalkComments from "@/components/ArtalkComments.astro";
import SiteTopbar from "@/components/SiteTopbar.astro";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import { getLocaleFromPath, toAbsoluteUrl, ui } from "@/i18n";
import { getLastModified } from "@/utils/getLastModified.js";

type Props = MarkdownLayoutProps<{ title: string; headingEyebrow?: string }>;

const { frontmatter } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];
const isEn = locale === "en";
const lastUpdated = getLastModified(
  isEn ? "src/pages/en/about.mdx" : "src/pages/about.mdx"
);
const alternates = [
  { hreflang: "zh-CN", href: toAbsoluteUrl("/about", Astro.url) },
  { hreflang: "en", href: toAbsoluteUrl("/en/about", Astro.url) },
  { hreflang: "x-default", href: toAbsoluteUrl("/about", Astro.url) },
];
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={copy.pages.aboutDesc}
  {locale}
  {alternates}
>
  <SiteTopbar />
  <main
    id="main-content"
    class="mx-auto w-full max-w-4xl px-4 pt-6 pb-10 sm:px-6 md:pt-10 md:pb-14"
  >
    <PageHeader title={frontmatter.title}>
      {
        lastUpdated && (
          <dl class="flex flex-wrap gap-x-6 gap-y-0.5">
            <div class="flex items-center gap-1.5">
              <dt class="text-foreground/45">{copy.actions.updated}</dt>
              <dd>{lastUpdated}</dd>
            </div>
          </dl>
        )
      }
    </PageHeader>
    <section id="about" class="app-prose prose-img:border-0">
      <div class="*:first:mt-0">
        <slot />
      </div>
    </section>
    <ArtalkComments
      pageKey={isEn ? "/en/about" : "/about"}
      pageTitle={frontmatter.title}
      title={copy.actions.comments}
      placeholder={copy.actions.commentPlaceholder}
      noComment={copy.actions.noComment}
      counter={copy.actions.commentCount}
    />
  </main>
</Layout>
