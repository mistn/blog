---
import IconMail from "@/assets/icons/IconMail.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import HomeTabs from "@/components/HomeTabs.astro";
import { getNavItems, SOCIALS } from "@/constants";
import { SITE } from "@/config";
import { getLocaleFromPath, localizePath, normalizePath, ui } from "@/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];
// RSS 不占顶栏和抽屉，只在底栏保留。
const emailLink = SOCIALS.find(social => social.href.startsWith("mailto:"));
const emailAddress = emailLink?.href.replace("mailto:", "");
// 文字只写「邮件」，地址留给 title / aria-label，读屏和长按预览还能拿到
const emailLabel = emailAddress
  ? `${copy.nav.email} ${emailAddress}`
  : copy.nav.email;

const getHref = (path: string) => localizePath(path, locale);
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (path: string) => currentPath === normalizePath(getHref(path));
const navItems = getNavItems();
---

<header id="site-topbar" class="site-topbar sticky top-0 z-30">
  <div class="topbar-row mx-auto w-full max-w-4xl px-5 sm:px-6">
    <div class="flex items-center justify-between gap-3">
      <!-- 站点标识：头像 + 站名 -->
      <a
        href={getHref("/")}
        class="group flex min-w-0 shrink items-center gap-2.5"
        aria-label={SITE.title}
      >
        <img
          src="/avatar.avif"
          alt=""
          width="32"
          height="32"
          class="size-8 shrink-0 rounded-full object-cover transition-transform duration-200 group-hover:scale-105"
        />
        <span
          class="truncate text-[15px] font-medium tracking-tight text-foreground"
        >
          {SITE.title}
        </span>
      </a>

      <!-- 桌面端主导航 -->
      <div class="hidden min-w-0 flex-1 justify-center px-4 lg:flex">
        <HomeTabs />
      </div>

      <!-- 操作区 -->
      <div class="flex shrink-0 items-center gap-0.5 sm:gap-1">
        <!-- 桌面端图标 -->
        <div class="hidden items-center gap-1 lg:flex">
          <a
            href={localizePath("/search", locale)}
            class="icon-btn"
            aria-current={isActive("/search") ? "page" : undefined}
            title={copy.nav.search}
            aria-label={copy.nav.search}
          >
            <IconSearch class="size-5" />
          </a>

          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn-desktop"
                type="button"
                class="icon-btn"
                title={copy.nav.theme}
                aria-label={copy.nav.theme}
                aria-live="polite"
              >
                <span
                  data-theme-icon-anchor
                  class="pointer-events-none relative block size-5"
                  aria-hidden="true"
                >
                  <IconMoon class="absolute inset-0 size-full scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute inset-0 size-full scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </span>
              </button>
            )
          }
        </div>

        <!-- 移动端只留菜单：搜索和主题都收进抽屉底部的工具行 -->
        <div class="flex items-center gap-0.5 lg:hidden">
          <button
            id="menu-toggle"
            type="button"
            class="group icon-btn relative"
            aria-label={copy.nav.openMenu}
            aria-controls="mobile-dropdown"
            aria-expanded="false"
            data-open-label={copy.nav.openMenu}
            data-close-label={copy.nav.closeMenu}
          >
            <svg
              class="absolute size-5 transition-all duration-300 ease-in-out group-aria-expanded:scale-50 group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
            <svg
              class="absolute size-5 scale-50 -rotate-90 opacity-0 transition-all duration-300 ease-in-out group-aria-expanded:scale-100 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- ===== 移动端顶栏展开菜单 =====
       参考 AstroPaper：菜单留在文档流里，展开时把 hidden 去掉（display 恢复），
       header 随之变高，下方内容被自然顶下去；收起时重新 hidden。
       不用 absolute、不盖内容、不加遮罩、不锁滚动。 -->
  <div id="mobile-dropdown" class="mobile-sheet lg:hidden" hidden>
    <nav class="sheet-list" aria-label={copy.nav.menu}>
      {
        navItems.map(item => {
          const Icon = item.icon;
          return (
            <a
              href={getHref(item.path)}
              class="sheet-item"
              aria-current={isActive(item.path) ? "page" : undefined}
              data-menu-link
            >
              <Icon class="size-[18px] shrink-0" />
              <span class="truncate">{copy.nav[item.labelKey]}</span>
            </a>
          );
        })
      }
      {/* 两列网格下，奇数个导航项会空出右下角，补一个格子盖住分隔线底色 */}
      {
        navItems.length % 2 === 1 && (
          <span class="sheet-filler" aria-hidden="true" />
        )
      }
    </nav>

    <!-- 底部工具行：搜索 / 主题 / 邮件，低频操作共用一行，不给导航列表加高 -->
    <div class="sheet-utils">
      <a
        href={localizePath("/search", locale)}
        class="sheet-util"
        title={copy.nav.search}
        aria-label={copy.nav.search}
        aria-current={isActive("/search") ? "page" : undefined}
        data-menu-link
      >
        <IconSearch class="size-4 shrink-0" />
        <span>{copy.nav.search}</span>
      </a>
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="sheet-util"
            title={copy.nav.theme}
            aria-label={copy.nav.theme}
            aria-live="polite"
          >
            <span
              data-theme-icon-anchor
              class="pointer-events-none relative block size-4"
              aria-hidden="true"
            >
              <IconMoon class="absolute inset-0 size-full scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute inset-0 size-full scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </span>
            <span
              data-theme-label
              data-target-dark={copy.nav.themeToDark}
              data-target-light={copy.nav.themeToLight}
            >
              {copy.nav.themeToDark}
            </span>
          </button>
        )
      }
      <a
        href={emailAddress ? `mailto:${emailAddress}` : "mailto:"}
        class="sheet-util sheet-util-mail"
        title={emailLabel}
        aria-label={emailLabel}
        data-menu-link
      >
        <IconMail class="size-4 shrink-0" />
        <span>{copy.nav.mail}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function getSheet() {
    return document.getElementById("mobile-dropdown");
  }
  function getTopbar() {
    return document.getElementById("site-topbar");
  }
  function getToggle() {
    return document.getElementById("menu-toggle");
  }

  function isMenuOpen() {
    const toggle = getToggle();
    return !!toggle && toggle.getAttribute("aria-expanded") === "true";
  }

  function setExpanded(open) {
    const toggle = getToggle();
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute(
      "aria-label",
      open ? toggle.dataset.closeLabel : toggle.dataset.openLabel
    );
    // 菜单展开时顶栏要变成不透明实色，否则页面内容会从顶栏那条透出来。
    const bar = getTopbar();
    if (bar) bar.classList.toggle("menu-open", open);
  }

  function openMenu() {
    const sheet = getSheet();
    if (!sheet) return;

    // 菜单在文档流里：显示出来 header 就被撑高，页面内容跟着下移。
    sheet.hidden = false;
    setExpanded(true);
  }

  function closeMenu(returnFocus) {
    const sheet = getSheet();
    if (!sheet) return;

    sheet.hidden = true;
    setExpanded(false);

    if (returnFocus) {
      const toggle = getToggle();
      if (toggle) toggle.focus({ preventScroll: true });
    }
  }

  function closeMenuSilent() {
    // 换页时不做动画，直接收起。
    closeMenu(false);
  }

  document.addEventListener("click", function (e) {
    const target = /** @type {HTMLElement} */ (e.target);
    if (!target || typeof target.closest !== "function") return;

    if (target.closest("#menu-toggle")) {
      if (isMenuOpen()) closeMenu(true);
      else openMenu();
      return;
    }

    if (target.closest("[data-menu-link]")) {
      closeMenu(false);
      return;
    }

    // 点击抽屉以外的区域也收起：菜单是浮层，点下面正文应该回到阅读。
    // 抽屉内部（含主题按钮）不算外部，不会误关。
    if (isMenuOpen() && !target.closest("#mobile-dropdown")) {
      closeMenu(false);
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape" || !isMenuOpen()) return;
    closeMenu(true);
  });

  document.addEventListener("astro:before-swap", closeMenuSilent);

  // 菜单展开时把窗口拉宽到桌面断点，直接收起菜单（桌面端没有抽屉）。
  window.addEventListener("resize", function () {
    if (isMenuOpen() && window.innerWidth >= 1024) closeMenu(false);
  });
</script>

<script is:inline>
  (function initTopbarScroll() {
    if (window.__topbarScrollInit) return;
    window.__topbarScrollInit = true;

    function sync() {
      const bar = document.getElementById("site-topbar");
      if (!bar) return;
      bar.classList.toggle("is-scrolled", window.scrollY > 4);
    }

    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:page-load", sync);
    sync();
  })();
</script>

<style>
  .site-topbar {
    background: transparent;
    border-bottom: 1px solid transparent;
    /* margin-bottom 参与「收回顶栏高度」的补偿，见 .is-scrolled */
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      margin-bottom 0.25s ease;
  }

  .site-topbar .topbar-row {
    padding-top: 22px;
    padding-bottom: 16px;
    transition:
      padding-top 0.25s ease,
      padding-bottom 0.25s ease;
  }

  .site-topbar.is-scrolled {
    /* 80% 不透明度在「毛玻璃可见」和「背后文字不干扰」之间取平衡。
       blur(16px) 把穿透过来的内容糊到认不出字，这样即使 20% 透明也能看。 */
    background: color-mix(in srgb, var(--background) 80%, transparent);
    /* iOS Safari 对 position:sticky + backdrop-filter 有已知 bug，
       必须触发 GPU 层才会渲染毛玻璃。 */
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    border-bottom-color: var(--border);

    /* 顶栏在滚动后会收窄 18px（padding-top 22→10、padding-bottom 16→10）。
       sticky 元素仍占文档流，高度一变，整个文档高度就跟着变，浏览器会把
       滚动位置拉回去补偿；被拉回后 scrollY 跌破阈值，is-scrolled 又失效，
       顶栏重新变高 —— 于是卡在顶部反复上下抖。
       用等量的 margin-bottom 把少掉的高度补回来（两者同一条过渡曲线，
       所以每一帧的总高度都恒为 79px），文档高度不变，反馈环就断了。
       若以后调整上面两组 padding，这里的 18px 要同步改。 */
    margin-bottom: 18px;
  }

  .site-topbar.is-scrolled .topbar-row {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  /* 菜单展开时顶栏不再强制不透明：保留毛玻璃，
     和抽屉的柔和表面保持同一种质感；只把下边线压淡，
     避免在玻璃和实心面板之间出现一条生硬的分界。 */
  .site-topbar.menu-open {
    border-bottom-color: color-mix(in srgb, var(--border) 55%, transparent);
  }

  /* 滚动后展开菜单时，顶栏下方就是实心的抽屉面板。
     顶栏仍保持毛玻璃，但把不透明度提到 92%：
     既有玻璃的质感，又不会因为透出正文而和面板差出一个色阶（深色模式尤其明显）。 */
  .site-topbar.is-scrolled.menu-open {
    background: color-mix(in srgb, var(--background) 92%, transparent);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }

  @media (hover: hover) {
    .icon-btn:hover {
      color: var(--accent);
      background: var(--muted);
    }
  }

  .icon-btn:active {
    background: var(--muted);
  }

  .icon-btn[aria-current="page"] {
    color: var(--accent);
  }

  /* 移动端菜单：留在文档流里，展开时把 hidden 去掉，
     header 被自然撑高，正文跟着下移；如果页面已经滚动，
     浏览器会补偿滚动位置，表现为原地展开（见下方 is-scrolled 的说明）。
     没有绝对定位、没有遮罩、不锁页面滚动。 */
  .mobile-sheet {
    background: var(--background);
    /* 顶栏是 sticky 的：横屏等超矮视口下，菜单不能高过视口，
       否则底部会被顶出屏幕且滚不回来。超出时让菜单自己滚。 */
    max-height: calc(100vh - 5.5rem);
    max-height: calc(100dvh - 5.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-sheet[hidden] {
    display: none;
  }

  /* 页面已经滚动时展开：sticky 顶栏 + 浏览器的 scroll anchoring 会让正文
     视觉上原地不动，菜单表现为「盖住」上方内容（关闭后滚动位置原样还原）。
     这时补一层柔和投影，让下面的内容读成「被一层盖住」而不是「被裁掉」。 */
  .site-topbar.is-scrolled .mobile-sheet {
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    box-shadow: 0 16px 30px -20px rgb(0 0 0 / 0.5);
  }

  /* 两列网格：6 项铺成 3 行，抽屉从 ~335px 降到 ~200px。
     和顶栏的毛玻璃统一成「柔和表面」语言：不画满格硬线，
     用留白 + 圆角 hover/active 区分条目，避免表格感。 */
  .sheet-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    padding: 6px;
    background: transparent;
  }

  .sheet-item,
  .sheet-filler {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 12px 14px;
    border-radius: 10px;
    background: transparent;
    font-size: 15px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    transition:
      color 0.16s ease,
      background-color 0.16s ease;
  }

  /* 导航项为奇数个时补一个空格子，避免右下角露出 border 底色 */
  .sheet-filler {
    pointer-events: none;
  }

  .sheet-item svg {
    opacity: 0.6;
    transition: opacity 0.16s ease;
  }

  @media (hover: hover) {
    .sheet-item:not([aria-current="page"]):hover {
      /* 比选中态轻一档：hover 只是“鼠标在这”，不该像第二个当前页 */
      background: color-mix(in srgb, var(--muted) 65%, transparent);
      color: var(--foreground);
    }

    .sheet-item:not([aria-current="page"]):hover svg {
      opacity: 0.85;
    }
  }

  .sheet-item:not([aria-current="page"]):active {
    background: var(--muted);
    color: var(--foreground);
  }

  /* 当前页：和 hover 同形状的淡色圆角块，左右两列都对齐 */
  .sheet-item[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .sheet-item[aria-current="page"] svg {
    opacity: 1;
  }

  /* 抽屉底部工具行：搜索 / 主题 / 邮件，低频操作共用一行 */
  .sheet-utils {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    padding: 8px 10px;
    /* 只留一条很淡的分界，和网格的柔和表面保持一致 */
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }

  .sheet-util {
    display: inline-flex;
    min-width: 0;
    min-height: 40px;
    max-width: 100%;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    transition:
      color 0.16s ease,
      background-color 0.16s ease;
  }

  /* 邮件靠右，和左边的搜索、主题分开；窄屏换行后自然占满一行 */
  .sheet-util-mail {
    margin-left: auto;
  }

  /* 当前在搜索页时点亮工具行里的搜索入口 */
  .sheet-util[aria-current="page"] {
    color: var(--accent);
  }

  @media (hover: hover) {
    .sheet-util:hover {
      background: var(--muted);
      color: var(--foreground);
    }
  }

  .sheet-util:active {
    background: var(--muted);
    color: var(--foreground);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-topbar.is-scrolled {
      backdrop-filter: blur(16px) saturate(140%);
    }
  }
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .site-topbar.is-scrolled {
      -webkit-backdrop-filter: blur(16px) saturate(140%);
    }
  }

  /* 不支持 backdrop-filter 时顶栏没有磨砂，用更实的背景保证可读性 */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .site-topbar.is-scrolled {
      background: color-mix(in srgb, var(--background) 92%, transparent);
    }
  }
</style>
