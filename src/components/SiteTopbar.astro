---
import IconMail from "@/assets/icons/IconMail.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import HomeTabs from "@/components/HomeTabs.astro";
import { NAV_ITEMS, SOCIALS } from "@/constants";
import { SITE } from "@/config";
import { getLocaleFromPath, localizePath, normalizePath, ui } from "@/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];
const emailLink = SOCIALS.find(social => social.href.startsWith("mailto:"));
const emailAddress = emailLink?.href.replace("mailto:", "");
const emailLabel = `${copy.nav.email} ${SITE.title}`;

const getHref = (path: string) => localizePath(path, locale);
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (path: string) => currentPath === normalizePath(getHref(path));
const navItems = NAV_ITEMS.filter(item => !item.hidden);
---

<header id="site-topbar" class="site-topbar sticky top-0 z-30">
  <div class="topbar-row mx-auto w-full max-w-4xl px-5 sm:px-6">
    <div class="flex items-center justify-between gap-3">
      <!-- 站点标识：头像 + 站名 -->
      <a
        href={getHref("/")}
        class="group flex min-w-0 shrink items-center gap-2.5"
        aria-label={SITE.title}
      >
        <img
          src="/avatar.avif"
          alt=""
          width="32"
          height="32"
          class="size-8 shrink-0 rounded-full object-cover transition-transform duration-200 group-hover:scale-105"
        />
        <span
          class="truncate text-[15px] font-medium tracking-tight text-foreground"
        >
          {SITE.title}
        </span>
      </a>

      <!-- 桌面端主导航 -->
      <div class="hidden min-w-0 flex-1 justify-center px-4 lg:flex">
        <HomeTabs />
      </div>

      <!-- 操作区 -->
      <div class="flex shrink-0 items-center gap-0.5 sm:gap-1">
        <!-- 桌面端图标 -->
        <div class="hidden items-center gap-1 lg:flex">
          <a
            href={localizePath("/search", locale)}
            class="icon-btn"
            aria-current={isActive("/search") ? "page" : undefined}
            title={copy.nav.search}
            aria-label={copy.nav.search}
          >
            <IconSearch class="size-5" />
          </a>

          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn-desktop"
                type="button"
                class="icon-btn"
                title={copy.nav.theme}
                aria-label={copy.nav.theme}
                aria-live="polite"
              >
                <span
                  data-theme-icon-anchor
                  class="pointer-events-none relative block size-5"
                  aria-hidden="true"
                >
                  <IconMoon class="absolute inset-0 size-full scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute inset-0 size-full scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </span>
              </button>
            )
          }

          <a href="/rss.xml" class="icon-btn" title="RSS" aria-label="RSS">
            <IconRss class="size-5" />
          </a>
        </div>

        <!-- 移动端：搜索 / 主题 / 菜单 -->
        <div class="flex items-center gap-0.5 lg:hidden">
          <a
            href={localizePath("/search", locale)}
            class="icon-btn"
            title={copy.nav.search}
            aria-label={copy.nav.search}
          >
            <IconSearch class="size-5" />
          </a>

          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn"
                type="button"
                class="icon-btn"
                title={copy.nav.theme}
                aria-label={copy.nav.theme}
                aria-live="polite"
              >
                <span
                  data-theme-icon-anchor
                  class="pointer-events-none relative block size-5"
                  aria-hidden="true"
                >
                  <IconMoon class="absolute inset-0 size-full scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute inset-0 size-full scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </span>
              </button>
            )
          }

          <button
            id="menu-toggle"
            type="button"
            class="group icon-btn relative"
            aria-label={copy.nav.openMenu}
            aria-controls="mobile-dropdown"
            aria-expanded="false"
          >
            <svg
              class="absolute size-5 transition-all duration-300 ease-in-out group-aria-expanded:scale-50 group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
            <svg
              class="absolute size-5 scale-50 -rotate-90 opacity-0 transition-all duration-300 ease-in-out group-aria-expanded:scale-100 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ===== 移动端抽屉 ===== -->
<div
  id="mobile-dropdown"
  class="mobile-drawer fixed top-0 right-0 z-[60] flex h-full w-[62vw] max-w-[204px] translate-x-full flex-col bg-background opacity-0 transition-[transform,opacity] duration-300 ease-out"
>
  <div class="flex justify-end px-2 pt-2">
    <button
      id="sidebar-close"
      type="button"
      class="icon-btn"
      aria-label={copy.nav.closeMenu}
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto pt-1 pb-6" aria-label={copy.nav.menu}>
    {
      navItems.map(item => {
        const Icon = item.icon;
        return (
          <a
            href={getHref(item.path)}
            class="drawer-item"
            aria-current={isActive(item.path) ? "page" : undefined}
            data-menu-link
          >
            <Icon class="size-4 shrink-0" />
            <span>{copy.nav[item.labelKey]}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="flex items-center gap-1 border-t border-border px-4 py-3">
    <a
      href={emailAddress ? `mailto:${emailAddress}` : "mailto:"}
      class="icon-btn"
      title={emailLabel}
      aria-label={emailLabel}
      data-menu-link
    >
      <IconMail class="size-5" />
    </a>
    <a
      href="/rss.xml"
      class="icon-btn"
      title="RSS"
      aria-label="RSS"
      data-menu-link
    >
      <IconRss class="size-5" />
    </a>
  </div>
</div>

<!-- ===== 抽屉遮罩 ===== -->
<div
  id="mobile-overlay"
  class="mobile-overlay fixed inset-0 z-40 hidden opacity-0 transition-opacity duration-200 ease-out"
>
</div>

<script is:inline>
  function getSidebar() {
    return document.getElementById("mobile-dropdown");
  }
  function getOverlay() {
    return document.getElementById("mobile-overlay");
  }
  function getToggle() {
    return document.getElementById("menu-toggle");
  }

  // 刚展开后的短暂窗口内忽略「关闭」，避免移动端连点两次把刚打开的抽屉立刻关掉。
  // 展开后抽屉会盖住右上角的菜单按钮，第二次点击实际落在抽屉内的 X 上。
  var OPEN_GUARD_MS = 320;
  var openedAt = 0;
  // 关闭动画结束后再隐藏遮罩。用可取消的定时器代替一次性的 transitionend：
  // 「关 → 立刻开」时旧的 transitionend 会把重新打开的遮罩误设为 hidden，
  // 导致菜单可见却没有蒙层、点外部关不掉、页面还锁着滚动。
  var overlayHideTimer = null;

  function isMenuOpen() {
    const toggle = getToggle();
    return toggle && toggle.getAttribute("aria-expanded") === "true";
  }

  function preventScroll(e) {
    e.preventDefault();
  }

  function lockScroll() {
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
  }

  function unlockScroll() {
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
  }

  function openMenu() {
    const sb = getSidebar();
    const overlay = getOverlay();
    const toggle = getToggle();
    if (!sb || !overlay || !toggle) return;

    if (overlayHideTimer) {
      clearTimeout(overlayHideTimer);
      overlayHideTimer = null;
    }
    openedAt = Date.now();

    lockScroll();
    document.addEventListener("touchmove", preventScroll, { passive: false });
    overlay.addEventListener("wheel", preventScroll, { passive: false });
    overlay.addEventListener("touchmove", preventScroll, { passive: false });

    overlay.classList.remove("hidden");
    sb.classList.remove("translate-x-full");
    sb.classList.remove("opacity-0");
    requestAnimationFrame(function () {
      overlay.classList.remove("opacity-0");
      sb.classList.add("translate-x-0");
      sb.classList.add("opacity-100");
    });

    sb.removeAttribute("inert");
    overlay.removeAttribute("inert");
    sb.setAttribute("aria-hidden", "false");
    overlay.setAttribute("aria-hidden", "false");
    toggle.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    const sb = getSidebar();
    const overlay = getOverlay();
    if (!sb || !overlay) return;

    unlockScroll();
    document.removeEventListener("touchmove", preventScroll);
    overlay.removeEventListener("wheel", preventScroll);
    overlay.removeEventListener("touchmove", preventScroll);

    overlay.classList.add("opacity-0");
    sb.classList.remove("translate-x-0");
    sb.classList.remove("opacity-100");
    sb.classList.add("translate-x-full");
    sb.classList.add("opacity-0");

    if (overlayHideTimer) clearTimeout(overlayHideTimer);
    overlayHideTimer = setTimeout(function () {
      overlayHideTimer = null;
      // 动画期间若已重新打开，就不要隐藏遮罩
      if (isMenuOpen()) return;
      overlay.classList.add("hidden");
    }, 320);

    sb.setAttribute("aria-hidden", "true");
    sb.setAttribute("inert", "");
    overlay.setAttribute("aria-hidden", "true");
    overlay.setAttribute("inert", "");

    const toggle = getToggle();
    if (toggle) toggle.setAttribute("aria-expanded", "false");
  }

  function closeMenuSilent() {
    const sb = getSidebar();
    const overlay = getOverlay();
    if (!sb || !overlay) return;

    if (overlayHideTimer) {
      clearTimeout(overlayHideTimer);
      overlayHideTimer = null;
    }

    unlockScroll();
    document.removeEventListener("touchmove", preventScroll);
    overlay.removeEventListener("wheel", preventScroll);
    overlay.removeEventListener("touchmove", preventScroll);

    sb.classList.add("translate-x-full");
    sb.classList.remove("translate-x-0");
    sb.classList.add("opacity-0");
    sb.classList.remove("opacity-100");
    sb.setAttribute("aria-hidden", "true");
    sb.setAttribute("inert", "");
    overlay.classList.add("hidden", "opacity-0");
    overlay.setAttribute("aria-hidden", "true");
    overlay.setAttribute("inert", "");

    const toggle = getToggle();
    if (toggle) toggle.setAttribute("aria-expanded", "false");
  }

  document.addEventListener("click", function (e) {
    const target = /** @type {HTMLElement} */ (e.target);

    if (target.closest("#menu-toggle") || target.closest("#sidebar-close")) {
      if (isMenuOpen()) {
        // 刚展开就来的第二次点击视为误触，忽略，避免「开→关」闪烁
        if (Date.now() - openedAt < OPEN_GUARD_MS) return;
        closeMenu();
      } else {
        openMenu();
      }
      return;
    }

    if (target.closest("[data-menu-link]")) {
      closeMenu();
      return;
    }

    if (target.closest("#mobile-overlay")) {
      if (Date.now() - openedAt < OPEN_GUARD_MS) return;
      closeMenu();
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    const sb = getSidebar();
    if (sb && !sb.classList.contains("translate-x-full")) closeMenu();
  });

  document.addEventListener("astro:before-swap", function () {
    closeMenuSilent();
  });

  (function initHidden() {
    const sb = getSidebar();
    const overlay = getOverlay();
    if (sb) {
      sb.setAttribute("aria-hidden", "true");
      sb.setAttribute("inert", "");
    }
    if (overlay) {
      overlay.setAttribute("aria-hidden", "true");
      overlay.setAttribute("inert", "");
    }
  })();
</script>

<script is:inline>
  (function initTopbarScroll() {
    if (window.__topbarScrollInit) return;
    window.__topbarScrollInit = true;

    function sync() {
      const bar = document.getElementById("site-topbar");
      if (!bar) return;
      bar.classList.toggle("is-scrolled", window.scrollY > 4);
    }

    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:page-load", sync);
    sync();
  })();
</script>

<style>
  .site-topbar {
    background: transparent;
    border-bottom: 1px solid transparent;
    /* margin-bottom 参与「收回顶栏高度」的补偿，见 .is-scrolled */
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      margin-bottom 0.25s ease;
  }

  .site-topbar .topbar-row {
    padding-top: 22px;
    padding-bottom: 16px;
    transition:
      padding-top 0.25s ease,
      padding-bottom 0.25s ease;
  }

  .site-topbar.is-scrolled {
    background: color-mix(in srgb, var(--background) 88%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom-color: var(--border);

    /* 顶栏在滚动后会收窄 18px（padding-top 22→10、padding-bottom 16→10）。
       sticky 元素仍占文档流，高度一变，整个文档高度就跟着变，浏览器会把
       滚动位置拉回去补偿；被拉回后 scrollY 跌破阈值，is-scrolled 又失效，
       顶栏重新变高 —— 于是卡在顶部反复上下抖。
       用等量的 margin-bottom 把少掉的高度补回来（两者同一条过渡曲线，
       所以每一帧的总高度都恒为 79px），文档高度不变，反馈环就断了。
       若以后调整上面两组 padding，这里的 18px 要同步改。 */
    margin-bottom: 18px;
  }

  .site-topbar.is-scrolled .topbar-row {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }

  @media (hover: hover) {
    .icon-btn:hover {
      color: var(--accent);
      background: var(--muted);
    }
  }

  .icon-btn:active {
    background: var(--muted);
  }

  .icon-btn[aria-current="page"] {
    color: var(--accent);
  }

  .drawer-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 24px;
    font-size: 16px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
    transition:
      background-color 0.16s ease,
      color 0.16s ease;
  }

  .drawer-item svg {
    opacity: 0.55;
    transition: opacity 0.16s ease;
  }

  .drawer-item::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 10px;
    width: 2px;
    height: 0;
    background: var(--foreground);
    transform: translateY(-50%);
    transition: height 0.2s ease;
  }

  @media (hover: hover) {
    .drawer-item:not([aria-current="page"]):hover {
      background: var(--muted);
      color: var(--foreground);
    }

    .drawer-item:not([aria-current="page"]):hover svg {
      opacity: 0.8;
    }
  }

  .drawer-item:not([aria-current="page"]):active {
    background: var(--muted);
    color: var(--foreground);
  }

  .drawer-item[aria-current="page"] {
    color: var(--foreground);
  }

  .drawer-item[aria-current="page"] svg {
    opacity: 0.9;
  }

  .drawer-item[aria-current="page"]::before {
    height: 18px;
  }

  .mobile-overlay {
    /* 旧内核不支持 color-mix() 时整条 background 会失效、遮罩变全透明，先给固定色兜底 */
    background: rgba(15, 23, 42, 0.28);
    background: color-mix(in srgb, var(--foreground) 26%, transparent);
    backdrop-filter: blur(7px) saturate(120%);
    -webkit-backdrop-filter: blur(7px) saturate(120%);
  }

  /* 不支持 backdrop-filter 时没有磨砂，用更重的压暗补偿，避免看起来像遮罩没生效 */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .mobile-overlay {
      background: rgba(15, 23, 42, 0.5);
    }
  }
</style>
