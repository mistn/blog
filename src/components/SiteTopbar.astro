---
import IconMail from "@/assets/icons/IconMail.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import HomeTabs from "@/components/HomeTabs.astro";
import { getNavItems, SOCIALS } from "@/constants";
import { SITE } from "@/config";
import { getLocaleFromPath, localizePath, normalizePath, ui } from "@/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];
// RSS 不占顶栏：桌面端底部有入口，移动端在抽屉工具行里。
const emailLink = SOCIALS.find(social => social.href.startsWith("mailto:"));
const emailAddress = emailLink?.href.replace("mailto:", "");
// 文字只写「邮件」，地址留给 title / aria-label，读屏和长按预览还能拿到
const emailLabel = emailAddress
  ? `${copy.nav.email} ${emailAddress}`
  : copy.nav.email;

const getHref = (path: string) => localizePath(path, locale);
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (path: string) => currentPath === normalizePath(getHref(path));
const navItems = getNavItems();
---

<header id="site-topbar" class="site-topbar sticky top-0 z-30">
  <div class="topbar-row mx-auto w-full max-w-4xl px-5 sm:px-6">
    <div class="flex items-center justify-between gap-3">
      <!-- 站点标识：头像 + 站名 -->
      <a
        href={getHref("/")}
        class="group flex min-w-0 shrink items-center gap-2.5"
        aria-label={SITE.title}
      >
        <img
          src="/avatar.avif"
          alt=""
          width="32"
          height="32"
          class="size-8 shrink-0 rounded-full object-cover transition-transform duration-200 group-hover:scale-105"
        />
        <span
          class="truncate text-[15px] font-medium tracking-tight text-foreground"
        >
          {SITE.title}
        </span>
      </a>

      <!-- 桌面端主导航 -->
      <div class="hidden min-w-0 flex-1 justify-center px-4 lg:flex">
        <HomeTabs />
      </div>

      <!-- 操作区 -->
      <div class="flex shrink-0 items-center gap-0.5 sm:gap-1">
        <!-- 桌面端图标 -->
        <div class="hidden items-center gap-1 lg:flex">
          <a
            href={localizePath("/search", locale)}
            class="icon-btn"
            aria-current={isActive("/search") ? "page" : undefined}
            title={copy.nav.search}
            aria-label={copy.nav.search}
          >
            <IconSearch class="size-5" />
          </a>

          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn-desktop"
                type="button"
                class="icon-btn"
                title={copy.nav.theme}
                aria-label={copy.nav.theme}
                aria-live="polite"
              >
                <span
                  data-theme-icon-anchor
                  class="pointer-events-none relative block size-5"
                  aria-hidden="true"
                >
                  <IconMoon class="absolute inset-0 size-full scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute inset-0 size-full scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </span>
              </button>
            )
          }
        </div>

        <!-- 移动端只留搜索和菜单：主题收进抽屉底部的工具行 -->
        <div class="flex items-center gap-0.5 lg:hidden">
          <a
            href={localizePath("/search", locale)}
            class="icon-btn"
            title={copy.nav.search}
            aria-label={copy.nav.search}
          >
            <IconSearch class="size-5" />
          </a>

          <button
            id="menu-toggle"
            type="button"
            class="group icon-btn relative"
            aria-label={copy.nav.openMenu}
            aria-controls="mobile-dropdown"
            aria-expanded="false"
            data-open-label={copy.nav.openMenu}
            data-close-label={copy.nav.closeMenu}
          >
            <svg
              class="absolute size-5 transition-all duration-300 ease-in-out group-aria-expanded:scale-50 group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
            <svg
              class="absolute size-5 scale-50 -rotate-90 opacity-0 transition-all duration-300 ease-in-out group-aria-expanded:scale-100 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- ===== 移动端顶部下拉菜单 ===== -->
  <div
    id="mobile-dropdown"
    class="mobile-sheet lg:hidden"
    aria-hidden="true"
    inert
  >
    <div class="mx-auto w-full max-w-4xl px-5 pb-4 sm:px-6">
      <div class="mobile-sheet-panel">
        <nav class="grid grid-cols-2 gap-0.5 p-2" aria-label={copy.nav.menu}>
          {
            navItems.map(item => {
              const Icon = item.icon;
              return (
                <a
                  href={getHref(item.path)}
                  class="sheet-item"
                  aria-current={isActive(item.path) ? "page" : undefined}
                  data-menu-link
                >
                  <Icon class="size-[18px] shrink-0" />
                  <span class="truncate">{copy.nav[item.labelKey]}</span>
                </a>
              );
            })
          }
        </nav>

        <div class="sheet-utils border-t border-border">
          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn"
                type="button"
                class="sheet-util"
                title={copy.nav.theme}
                aria-label={copy.nav.theme}
                aria-live="polite"
              >
                <span
                  data-theme-icon-anchor
                  class="pointer-events-none relative block size-4"
                  aria-hidden="true"
                >
                  <IconMoon class="absolute inset-0 size-full scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute inset-0 size-full scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </span>
                <span
                  data-theme-label
                  data-target-dark={copy.nav.themeToDark}
                  data-target-light={copy.nav.themeToLight}
                >
                  {copy.nav.themeToDark}
                </span>
              </button>
            )
          }
          <a
            href="/rss.xml"
            class="sheet-util"
            title={copy.nav.rss}
            aria-label={copy.nav.rss}
            data-menu-link
          >
            <IconRss class="size-4 shrink-0" />
            <span>RSS</span>
          </a>
          <a
            href={emailAddress ? `mailto:${emailAddress}` : "mailto:"}
            class="sheet-util sheet-util-mail"
            title={emailLabel}
            aria-label={emailLabel}
            data-menu-link
          >
            <IconMail class="size-4 shrink-0" />
            <span>{copy.nav.mail}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ===== 下拉菜单遮罩 =====
     放在 header 外面是必须的：header 滚动后会挂 backdrop-filter，而带 backdrop-filter
     的元素会变成「backdrop root」，它里面的后代只能采样到 header 自己那一层背景，
     遮罩的 blur 就整个失效（表现为「页面没滚动时能糊，一滚就变纯色」）。
     挪成 header 的同级之后，遮罩采样的才是整页内容。 -->
<div
  id="mobile-overlay"
  class="mobile-overlay lg:hidden"
  aria-hidden="true"
  inert
>
</div>

<script is:inline>
  function getSheet() {
    return document.getElementById("mobile-dropdown");
  }
  function getOverlay() {
    return document.getElementById("mobile-overlay");
  }
  function getToggle() {
    return document.getElementById("menu-toggle");
  }

  function isMenuOpen() {
    const toggle = getToggle();
    return !!toggle && toggle.getAttribute("aria-expanded") === "true";
  }

  function preventScroll(e) {
    const target = e.target;
    // 面板自身在屏幕很矮时可能需要滚动，放行面板内部的滚动手势。
    if (target instanceof Element && target.closest(".mobile-sheet-panel")) {
      return;
    }
    e.preventDefault();
  }

  // 不用 overflow:hidden 锁滚动：那会让顶栏的 position: sticky 失效，
  // 菜单在页面滚动后打开时会跟着跑到视口外。改为拦截滚轮和触摸手势。
  function lockScroll() {
    document.addEventListener("wheel", preventScroll, { passive: false });
    document.addEventListener("touchmove", preventScroll, { passive: false });
  }

  function unlockScroll() {
    document.removeEventListener("wheel", preventScroll);
    document.removeEventListener("touchmove", preventScroll);
  }

  function setExpanded(open) {
    const toggle = getToggle();
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute(
      "aria-label",
      open ? toggle.dataset.closeLabel : toggle.dataset.openLabel
    );
  }

  function openMenu() {
    const sheet = getSheet();
    const overlay = getOverlay();
    if (!sheet || !overlay) return;

    lockScroll();

    sheet.classList.add("is-open");
    overlay.classList.add("is-open");
    sheet.removeAttribute("inert");
    overlay.removeAttribute("inert");
    sheet.setAttribute("aria-hidden", "false");
    overlay.setAttribute("aria-hidden", "false");
    setExpanded(true);
  }

  function closeMenu(returnFocus) {
    const sheet = getSheet();
    const overlay = getOverlay();
    if (!sheet || !overlay) return;

    unlockScroll();
    document.removeEventListener("touchmove", preventScroll);

    // 收起动画由 CSS transition 负责，这里只切换状态。
    sheet.classList.remove("is-open");
    overlay.classList.remove("is-open");
    sheet.setAttribute("inert", "");
    overlay.setAttribute("inert", "");
    sheet.setAttribute("aria-hidden", "true");
    overlay.setAttribute("aria-hidden", "true");
    setExpanded(false);

    if (returnFocus) {
      const toggle = getToggle();
      if (toggle) toggle.focus({ preventScroll: true });
    }
  }

  function closeMenuSilent() {
    // 换页时不做动画，直接收起并解锁滚动。
    closeMenu(false);
  }

  document.addEventListener("click", function (e) {
    const target = /** @type {HTMLElement} */ (e.target);
    if (!target || typeof target.closest !== "function") return;

    if (target.closest("#menu-toggle")) {
      if (isMenuOpen()) closeMenu(true);
      else openMenu();
      return;
    }

    if (target.closest("[data-menu-link]")) {
      closeMenu(false);
      return;
    }

    if (target.closest("#mobile-overlay")) closeMenu(true);
  });

  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape" || !isMenuOpen()) return;
    closeMenu(true);
  });

  document.addEventListener("astro:before-swap", closeMenuSilent);

  // 在菜单展开时把窗口拉宽到桌面断点，收起菜单并解除滚动锁定。
  window.addEventListener("resize", function () {
    if (isMenuOpen() && window.innerWidth >= 1024) closeMenu(false);
  });
</script>

<script is:inline>
  (function initTopbarScroll() {
    if (window.__topbarScrollInit) return;
    window.__topbarScrollInit = true;

    function sync() {
      const bar = document.getElementById("site-topbar");
      if (!bar) return;
      bar.classList.toggle("is-scrolled", window.scrollY > 4);
    }

    window.addEventListener("scroll", sync, { passive: true });
    document.addEventListener("astro:page-load", sync);
    sync();
  })();
</script>

<style>
  .site-topbar {
    background: transparent;
    border-bottom: 1px solid transparent;
    /* margin-bottom 参与「收回顶栏高度」的补偿，见 .is-scrolled */
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      margin-bottom 0.25s ease;
  }

  .site-topbar .topbar-row {
    padding-top: 22px;
    padding-bottom: 16px;
    transition:
      padding-top 0.25s ease,
      padding-bottom 0.25s ease;
  }

  .site-topbar.is-scrolled {
    background: color-mix(in srgb, var(--background) 88%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom-color: var(--border);

    /* 顶栏在滚动后会收窄 18px（padding-top 22→10、padding-bottom 16→10）。
       sticky 元素仍占文档流，高度一变，整个文档高度就跟着变，浏览器会把
       滚动位置拉回去补偿；被拉回后 scrollY 跌破阈值，is-scrolled 又失效，
       顶栏重新变高 —— 于是卡在顶部反复上下抖。
       用等量的 margin-bottom 把少掉的高度补回来（两者同一条过渡曲线，
       所以每一帧的总高度都恒为 79px），文档高度不变，反馈环就断了。
       若以后调整上面两组 padding，这里的 18px 要同步改。 */
    margin-bottom: 18px;
  }

  .site-topbar.is-scrolled .topbar-row {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }

  @media (hover: hover) {
    .icon-btn:hover {
      color: var(--accent);
      background: var(--muted);
    }
  }

  .icon-btn:active {
    background: var(--muted);
  }

  .icon-btn[aria-current="page"] {
    color: var(--accent);
  }

  /* 顶部下拉面板：从顶栏下方展开，内容宽度与页面主体对齐 */
  .mobile-sheet {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 20;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .mobile-sheet.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-sheet-panel {
    max-height: calc(100dvh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--background);
    box-shadow:
      0 18px 40px -14px rgb(0 0 0 / 0.3),
      0 2px 8px -3px rgb(0 0 0 / 0.12);
  }

  .sheet-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 12px 12px;
    border-radius: 10px;
    font-size: 15px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    transition:
      background-color 0.16s ease,
      color 0.16s ease;
  }

  .sheet-item svg {
    opacity: 0.55;
    transition: opacity 0.16s ease;
  }

  @media (hover: hover) {
    .sheet-item:not([aria-current="page"]):hover {
      background: var(--muted);
      color: var(--foreground);
    }

    .sheet-item:not([aria-current="page"]):hover svg {
      opacity: 0.85;
    }
  }

  .sheet-item:not([aria-current="page"]):active {
    background: var(--muted);
    color: var(--foreground);
  }

  .sheet-item[aria-current="page"] {
    background: var(--muted);
    color: var(--foreground);
  }

  .sheet-item[aria-current="page"] svg {
    opacity: 0.9;
  }

  /* 抽屉底部工具行：主题 / 语言 / RSS / 邮件，四件低频操作共用一行 */
  .sheet-utils {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    padding: 6px 8px;
  }

  .sheet-util {
    display: inline-flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 8px;
    font-size: 13px;
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    transition:
      color 0.16s ease,
      background-color 0.16s ease;
  }

  /* 邮件靠右，和左边两个操作分开；窄屏换行后自然占满一行 */
  .sheet-util-mail {
    margin-left: auto;
  }

  @media (hover: hover) {
    .sheet-util:hover {
      background: var(--muted);
      color: var(--foreground);
    }
  }

  .sheet-util:active {
    background: var(--muted);
    color: var(--foreground);
  }

  .mobile-overlay {
    /* 固定在视口上、且是 header 的同级 —— 这两个条件缺一个，blur 就会被 header 的
       backdrop-filter 吃掉（见模板里那段注释）。 */
    position: fixed;
    inset: 0;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    /* 旧内核不支持 color-mix() 时整条 background 会失效、遮罩变全透明，先给固定色兜底 */
    background: rgba(15, 23, 42, 0.28);
    background: color-mix(in srgb, var(--foreground) 26%, transparent);
    backdrop-filter: blur(7px) saturate(120%);
    -webkit-backdrop-filter: blur(7px) saturate(120%);
  }

  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* 不支持 backdrop-filter 时没有磨砂，用更重的压暗补偿，避免看起来像遮罩没生效 */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .mobile-overlay {
      background: rgba(15, 23, 42, 0.5);
    }
  }
</style>
