---
import { SITE } from "@/config";

const displayYear = new Date().getFullYear();
---

<footer
  class="mx-auto w-full max-w-4xl border-t border-border px-5 sm:px-6"
>
  <div
    class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 py-5 text-sm whitespace-nowrap text-foreground/55"
  >
    <span>&#169; {displayYear} {SITE.author}</span>
    <span class="text-foreground/20" aria-hidden="true">|</span>
    <a
      class="transition-colors hover:text-foreground/85"
      href="https://icp.gov.moe/?keyword=20260260"
      target="_blank"
      rel="noopener noreferrer"
    >
      萌ICP备20260260号
    </a>
  </div>
</footer>
