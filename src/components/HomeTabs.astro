---
import { NAV_ITEMS } from "@/constants";
import { getLocaleFromPath, localizePath, normalizePath, ui } from "@/i18n";

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);
const copy = ui[locale];
const currentPath = normalizePath(pathname);
const getHref = (path: string) => localizePath(path, locale);
const isActive = (path: string) => currentPath === normalizePath(getHref(path));
const navItems = NAV_ITEMS.filter(item => !item.hidden);
---

<nav
  aria-label={copy.nav.menu}
  class="flex min-w-0 items-center gap-x-5 text-[15px] leading-6 whitespace-nowrap sm:gap-x-6"
>
  {
    navItems.map(item => (
      <a
        href={getHref(item.path)}
        aria-current={isActive(item.path) ? "page" : undefined}
        class="home-tab"
      >
        {copy.nav[item.labelKey]}
      </a>
    ))
  }
</nav>

<style>
  .home-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 4px 2px;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    transition: color 0.18s ease;
  }

  .home-tab::after {
    content: "";
    position: absolute;
    right: 2px;
    bottom: -2px;
    left: 2px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s ease;
  }

  @media (hover: hover) {
    .home-tab:hover {
      color: var(--foreground);
    }
  }

  .home-tab:active {
    color: var(--foreground);
  }

  .home-tab[aria-current="page"] {
    color: var(--foreground);
  }

  .home-tab[aria-current="page"]::after {
    transform: scaleX(1);
  }
</style>
