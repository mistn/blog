---
import { getLocaleFromPath, ui, type Locale } from "@/i18n";

type Props = {
  currentPage: number;
  lastPage: number;
  buildPageUrl: (pageNumber: number) => string;
  locale?: Locale;
};

const {
  currentPage,
  lastPage,
  buildPageUrl,
  locale = getLocaleFromPath(Astro.url.pathname),
} = Astro.props;

const copy = ui[locale];
const prevUrl = currentPage > 1 ? buildPageUrl(currentPage - 1) : undefined;
const nextUrl =
  currentPage < lastPage ? buildPageUrl(currentPage + 1) : undefined;

function getPages(): (number | "...")[] {
  if (lastPage <= 4) {
    return Array.from({ length: lastPage }, (_, i) => i + 1);
  }

  const shown = new Set([
    1,
    lastPage,
    currentPage - 1,
    currentPage,
    currentPage + 1,
  ]);

  const sorted = [...shown]
    .filter(p => p >= 1 && p <= lastPage)
    .sort((a, b) => a - b);

  const pages: (number | "...")[] = [];
  let prev = 0;
  for (const p of sorted) {
    if (prev && p - prev > 1) pages.push("...");
    pages.push(p);
    prev = p;
  }
  return pages;
}

const pages = getPages();
const linkClass =
  "page-num inline-flex items-center justify-center h-8 min-w-[2rem] px-1 text-sm text-foreground/55 no-underline transition-colors hover:text-foreground";
const activeClass = "text-foreground";
const disabledClass = "text-foreground/20 pointer-events-none";
const navBtnClass =
  "page-num inline-flex items-center justify-center h-8 w-8 text-lg text-foreground/45 transition-colors hover:text-foreground";
const navDisabledClass = "text-foreground/20";
---

{
  lastPage > 1 && (
    <nav
      class="mt-8 mb-4 flex items-center justify-center gap-1"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      {prevUrl ? (
        <a
          href={prevUrl}
          class={navBtnClass}
          aria-label={copy.actions.previousPageLabel}
        >
          ‹
        </a>
      ) : (
        <span class={[navBtnClass, navDisabledClass].join(" ")}>‹</span>
      )}

      {pages.map(p =>
        p === "..." ? (
          <span class="inline-flex h-8 min-w-[2rem] items-center justify-center text-sm text-foreground/30">
            ⋯
          </span>
        ) : p === currentPage ? (
          <span class={[linkClass, activeClass].join(" ")}>{p}</span>
        ) : (
          <a href={buildPageUrl(p)} class={linkClass}>
            {p}
          </a>
        )
      )}

      {nextUrl ? (
        <a
          href={nextUrl}
          class={navBtnClass}
          aria-label={copy.actions.nextPageLabel}
        >
          ›
        </a>
      ) : (
        <span class={[navBtnClass, navDisabledClass].join(" ")}>›</span>
      )}
    </nav>
  )
}

<style>
  .page-num {
    position: relative;
  }
  .page-num::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.25rem;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    transform: translateX(-50%) scaleX(0);
    transform-origin: left center;
    transition: transform 220ms ease;
  }
  .page-num:hover::after,
  .page-num.text-foreground::after {
    transform: translateX(-50%) scaleX(1);
  }
</style>
