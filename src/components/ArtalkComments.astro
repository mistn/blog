---
import { getLocaleFromPath, ui } from "@/i18n";

type Props = {
  pageKey: string;
  pageTitle: string;
};

const { pageKey, pageTitle } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];
---

<section
  class="mt-10 pt-8"
  data-pagefind-ignore
  data-artalk-root
  data-artalk-server="https://artalk.miuchan.com"
  data-artalk-site="blogs"
  data-artalk-page-key={pageKey}
  data-artalk-page-title={pageTitle}
  aria-label={copy.actions.comments}
>
  <h2 id="artalk-comments-title" class="text-[1.65rem] font-medium tracking-tight">
    {copy.actions.comments}
  </h2>
  <div class="artalk-container mt-5 min-h-28"></div>
</section>

<style>
  .artalk {
    --at-color-primary: var(--accent);
  }
</style>

<script is:inline>
  (function () {
    const CSS_URL = "https://unpkg.com/artalk@2.10.0/dist/Artalk.css";
    const JS_URL = "https://esm.sh/artalk@2.10.0";

    const TEXT = {
      counter: "{count} 条评论",
      email: "邮箱",
      link: "网址",
      nick: "昵称",
      noComment: "「此时无声胜有声」",
      placeholder: "键入内容...",
      send: "发送",
      sendBtn: "发送",
    };

    function isDarkTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark";
    }

    function ensureStyle() {
      if (document.querySelector('link[data-artalk-style]')) return;
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = CSS_URL;
      link.dataset.artalkStyle = "";
      document.head.appendChild(link);
    }

    let current = null;

    function readConfig() {
      const root = document.querySelector('[data-artalk-root]');
      if (!root) return null;
      return {
        server: root.dataset.artalkServer,
        site: root.dataset.artalkSite,
        pageKey: root.dataset.artalkPageKey,
        pageTitle: root.dataset.artalkPageTitle,
      };
    }

    async function mount() {
      const root = document.querySelector('[data-artalk-root]');
      if (!root) return;
      const el = /** @type {HTMLElement|null} */ (root.querySelector(".artalk-container"));
      if (!el) return;

      const conf = readConfig();
      if (!conf) return;

      ensureStyle();

      if (current?.destroy) current.destroy();
      current = null;
      el.innerHTML = "";

      try {
        const { default: Artalk } = await import(JS_URL);
        current = Artalk.init({
          el,
          server: conf.server,
          site: conf.site,
          pageKey: conf.pageKey,
          pageTitle: conf.pageTitle,
          darkMode: isDarkTheme(),
          locale: {
            counter: TEXT.counter,
            email: TEXT.email,
            link: TEXT.link,
            nick: TEXT.nick,
            noComment: TEXT.noComment,
            placeholder: TEXT.placeholder,
            send: TEXT.send,
          },
          noComment: TEXT.noComment,
          placeholder: TEXT.placeholder,
          preferRemoteConf: false,
          sendBtn: TEXT.sendBtn,
        });
      } catch {
        root.classList.add("hidden");
        const titleEl = document.getElementById("artalk-comments-title");
        if (titleEl) titleEl.classList.add("hidden");
      }
    }

    mount();

    document.addEventListener("astro:after-swap", mount);
    document.addEventListener("theme-change", () => {
      if (current?.setDarkMode) current.setDarkMode(isDarkTheme());
    });
  })();
</script>
