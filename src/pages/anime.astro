---
import PageHeader from "@/components/PageHeader.astro";
import SiteTopbar from "@/components/SiteTopbar.astro";
import Layout from "@/layouts/Layout.astro";
import ArtalkComments from "@/components/ArtalkComments.astro";
import animeData from "@/data/anime.generated.json";
import type { AnimeDataPayload, AnimeItem } from "@/types/anime";
import { getDateLocale, getLocaleFromPath, ui } from "@/i18n";

const data = animeData as AnimeDataPayload;
const locale = getLocaleFromPath(Astro.url.pathname);
const copy = ui[locale];

function getEntryKey(entry: AnimeItem) {
  return (
    entry.url || [entry.title.trim(), entry.cover, entry.year ?? ""].join("::")
  );
}

function normalizeItems(items: AnimeItem[]) {
  const seen = new Set<string>();
  const list: AnimeItem[] = [];

  for (const item of items ?? []) {
    const key = getEntryKey(item);
    if (!item?.title || !item?.cover || !item?.url || seen.has(key)) continue;
    seen.add(key);
    list.push(item);
  }

  return list;
}

function groupItems(items: AnimeItem[]) {
  const groups = new Map<string, AnimeItem[]>();

  for (const item of items ?? []) {
    const yearLabel = item.year ? String(item.year) : copy.anime.unknownYear;
    const list = groups.get(yearLabel);

    if (list) list.push(item);
    else groups.set(yearLabel, [item]);
  }

  return Array.from(groups.entries())
    .sort((a, b) => {
      const yearA = Number(a[0]);
      const yearB = Number(b[0]);
      const hasYearA = Number.isInteger(yearA) && yearA > 0;
      const hasYearB = Number.isInteger(yearB) && yearB > 0;

      if (!hasYearA && !hasYearB) return 0;
      if (!hasYearA) return 1;
      if (!hasYearB) return -1;

      return yearB - yearA;
    })
    .map(([yearLabel, entries]) => ({
      yearLabel,
      entries,
    }));
}

const entries = normalizeItems(data.items ?? []);
const groups = groupItems(entries);
const total = entries.length;
const pageTitle = copy.pages.animeFullTitle;
const pageDescription = copy.pages.animeDesc;
const sourceHref = data.username
  ? `https://anilist.co/user/${data.username}`
  : "https://anilist.co";

const updatedLabel = data.updatedAt
  ? new Intl.DateTimeFormat(getDateLocale(locale), {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "Asia/Shanghai",
    }).format(new Date(data.updatedAt))
  : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  {locale}
  structuredDataType="CollectionPage"
  structuredData={{
    mainEntity: {
      "@type": "ItemList",
      name: copy.anime.itemListName,
      numberOfItems: total,
    },
    about: "AniList completed anime collection.",
  }}
>
  <SiteTopbar />

  <main
    id="main-content"
    class="mx-auto w-full max-w-4xl px-4 pt-8 pb-10 sm:px-6 md:pt-12 md:pb-14"
    data-pagefind-body
  >
    <PageHeader title={copy.pages.animeTitle}>
      <dl class="flex flex-wrap gap-x-6 gap-y-0.5">
        <div class="flex items-center gap-1.5">
          <dt class="text-foreground/45">{copy.anime.total}</dt>
          <dd>{total} {copy.anime.countUnit}</dd>
        </div>
        <div class="flex items-center gap-1.5">
          <dt class="text-foreground/45">{copy.anime.dataFrom}</dt>
          <dd>
            <a
              href={sourceHref}
              target="_blank"
              rel="noreferrer"
              class="text-accent underline decoration-accent/35 underline-offset-4"
            >
              AniList{data.username ? ` / ${data.username}` : ""}
            </a>
          </dd>
        </div>
        {
          updatedLabel && (
            <div class="flex items-center gap-1.5">
              <dt class="text-foreground/45">{copy.anime.updatedAt}</dt>
              <dd>{updatedLabel}</dd>
            </div>
          )
        }
      </dl>
    </PageHeader>

    <div
      class="mb-12 inline-flex rounded-full bg-muted/60 p-1"
      role="tablist"
      aria-label={copy.anime.viewMode}
    >
      <button
        type="button"
        data-anime-toggle="all"
        aria-pressed="true"
        class="rounded-full px-5 py-1.5 text-sm font-medium text-foreground/50 transition-all hover:text-foreground/70 active:scale-95 aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm"
      >
        {copy.anime.viewAll}
      </button>
      <button
        type="button"
        data-anime-toggle="year"
        aria-pressed="false"
        class="rounded-full px-5 py-1.5 text-sm font-medium text-foreground/50 transition-all hover:text-foreground/70 active:scale-95 aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm"
      >
        {copy.anime.viewByYear}
      </button>
    </div>

    {
      entries.length > 0 ? (
        <div class="anime-view" data-anime-view="all">
          <div class="anime-archive anime-archive--all" data-anime-pane="all">
            <div class="grid min-h-[50vh] grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5">
              {entries.map((entry, index) => (
                <a
                  href={entry.url}
                  target="_blank"
                  rel="noreferrer"
                  class="group relative aspect-[2/3] overflow-hidden rounded-xl shadow-sm ring-1 ring-border/40 transition-all duration-200 ease-out active:scale-[0.97] active:brightness-95 md:hover:-translate-y-1 md:hover:shadow-md md:hover:ring-border/60"
                >
                  <img
                    src={entry.cover}
                    srcset={
                      entry.coverSmall
                        ? `${entry.coverSmall} 230w, ${entry.cover} 460w`
                        : undefined
                    }
                    sizes={
                      entry.coverSmall
                        ? "(min-width: 1024px) 160px, (min-width: 640px) 30vw, 45vw"
                        : undefined
                    }
                    alt={`${entry.title} ${copy.anime.coverAlt}`}
                    loading={index < 4 ? "eager" : "lazy"}
                    fetchpriority={index < 2 ? "high" : undefined}
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 md:group-hover:scale-105"
                  />
                  <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/80 via-black/40 to-transparent px-2.5 pt-6 pb-2.5">
                    <h3 class="line-clamp-2 text-[0.82rem] leading-snug font-semibold text-white sm:text-[0.88rem]">
                      {entry.title}
                    </h3>
                    <p class="mt-1 text-[0.72rem] text-white/60 sm:text-[0.75rem]">
                      {entry.year ? entry.year : copy.anime.unknownYear}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <div class="anime-archive anime-archive--year" data-anime-pane="year">
            {groups.map(group => (
              <section class="anime-year-section">
                <div class="anime-year-heading">
                  <h2>{group.yearLabel}</h2>
                  <p>
                    {group.entries.length} {copy.anime.countUnit}
                  </p>
                </div>

                <div class="grid min-h-[20vh] grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5">
                  {group.entries.map(entry => (
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noreferrer"
                      class="group relative aspect-[2/3] overflow-hidden rounded-xl shadow-sm ring-1 ring-border/40 transition-all duration-200 ease-out active:scale-[0.97] active:brightness-95 md:hover:-translate-y-1 md:hover:shadow-md md:hover:ring-border/60"
                    >
                      <img
                        src={entry.cover}
                        srcset={
                          entry.coverSmall
                            ? `${entry.coverSmall} 230w, ${entry.cover} 460w`
                            : undefined
                        }
                        sizes={
                          entry.coverSmall
                            ? "(min-width: 1024px) 160px, (min-width: 640px) 30vw, 45vw"
                            : undefined
                        }
                        alt={`${entry.title} ${copy.anime.coverAlt}`}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-500 md:group-hover:scale-105"
                      />
                      <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/80 via-black/40 to-transparent px-2.5 pt-6 pb-2.5">
                        <h3 class="line-clamp-2 text-[0.82rem] leading-snug font-semibold text-white sm:text-[0.88rem]">
                          {entry.title}
                        </h3>
                        <p class="mt-1 text-[0.72rem] text-white/60 sm:text-[0.75rem]">
                          {entry.year ? entry.year : copy.anime.unknownYear}
                        </p>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      ) : (
        <div class="border-t border-border/65 pt-8">
          <p class="text-[1.02rem] leading-8 text-foreground/66">
            {copy.anime.empty}
          </p>
          <p class="mt-2 text-sm leading-7 text-foreground/52">
            {copy.anime.emptyHelp}
          </p>
        </div>
      )
    }

    <ArtalkComments pageKey="/anime" pageTitle={pageTitle} />
  </main>

  <button
    id="anime-btt"
    class="pointer-events-none fixed right-4 bottom-8 z-50 flex size-10 items-center justify-center rounded-full border border-gray-200 bg-white/80 text-gray-600 opacity-0 shadow-lg backdrop-blur-md transition-all duration-300 sm:right-8 dark:border-gray-700 dark:bg-gray-800/80 dark:text-gray-300"
    aria-label={copy.anime.backToTop}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg
    >
  </button>
</Layout>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const bttBtn = document.getElementById("anime-btt");
    if (!bttBtn) return;

    function toggle() {
      if (window.scrollY > 300) {
        bttBtn.classList.remove("opacity-0", "pointer-events-none");
        bttBtn.classList.add("opacity-100", "pointer-events-auto");
      } else {
        bttBtn.classList.remove("opacity-100", "pointer-events-auto");
        bttBtn.classList.add("opacity-0", "pointer-events-none");
      }
    }

    window.addEventListener("scroll", toggle, { passive: true });
    bttBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    toggle();
  });
</script>

<script>
  document.addEventListener("astro:page-load", () => {
    const viewRoot = document.querySelector("[data-anime-view]");
    if (!(viewRoot instanceof HTMLElement)) return;

    const buttons = Array.from(
      document.querySelectorAll("[data-anime-toggle]")
    ).filter(
      (node): node is HTMLButtonElement => node instanceof HTMLButtonElement
    );

    if (!buttons.length) return;

    const setView = (value: string) => {
      viewRoot.dataset.animeView = value;
      buttons.forEach(button => {
        const isActive = button.dataset.animeToggle === value;
        button.setAttribute("aria-pressed", String(isActive));
      });
    };

    buttons.forEach(button => {
      button.addEventListener("click", () => {
        const value = button.dataset.animeToggle;
        if (!value) return;
        setView(value);
      });
    });
  });
</script>

<style>
  .anime-view {
    margin-top: 1.4rem;
  }

  .anime-view [data-anime-pane] {
    display: none;
  }

  .anime-view[data-anime-view="all"] [data-anime-pane="all"],
  .anime-view[data-anime-view="year"] [data-anime-pane="year"] {
    display: block;
  }

  .anime-archive--year {
    display: grid;
    gap: 2.4rem;
  }

  .anime-year-section {
    padding-top: 1.2rem;
  }

  .anime-year-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .anime-year-heading h2 {
    font-family: var(--font-ui-serif);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1;
  }

  .anime-year-heading p {
    color: color-mix(in srgb, var(--foreground) 44%, transparent);
    font-size: 0.88rem;
  }

  @media (max-width: 639px) {
    .anime-archive--year {
      gap: 2rem;
    }

    .anime-year-heading h2 {
      font-size: 1.45rem;
    }

    .anime-year-heading p {
      font-size: 0.8rem;
    }
  }
</style>
