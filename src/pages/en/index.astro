---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SiteTopbar from "@/components/SiteTopbar.astro";
import PostList from "@/components/PostList.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { BLOG_EN_PATH } from "@/content.config";
import { SITE } from "@/config";
import { localizePath, toAbsoluteUrl, ui } from "@/i18n";

const locale = "en";
const copy = ui[locale];
const posts = await getCollection("blogEn", ({ data }) => !data.draft);
const listPosts = getSortedPosts(posts);

const items = listPosts.map(post => ({
  href: localizePath(
    getPath(post.id, post.filePath, true, BLOG_EN_PATH),
    locale
  ),
  title: post.data.title,
  description: post.data.description,
  pubDatetime: post.data.pubDatetime,
  modDatetime: post.data.modDatetime,
}));

const pageTitle = `${SITE.title} - ${copy.pages.homeFullTitle}`;
const pageDesc = copy.pages.homeDesc;

const alternates = [
  { hreflang: "zh-CN", href: toAbsoluteUrl("/", Astro.url) },
  { hreflang: "en", href: toAbsoluteUrl("/en", Astro.url) },
  { hreflang: "x-default", href: toAbsoluteUrl("/", Astro.url) },
];
---

<Layout title={pageTitle} description={pageDesc} {locale} {alternates}>
  <SiteTopbar />
  <main
    id="main-content"
    data-layout="index"
    data-post-memory-scope="list"
    class="mx-auto w-full max-w-4xl px-5 pt-3 pb-6 sm:px-6 md:pt-4 md:pb-8"
  >
    <section class="overflow-hidden">
      <h1 class="sr-only">{copy.pages.postsTitle}</h1>
      <div class="py-1.5 md:py-4">
        <PostList items={items} {locale} />
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }
  });
</script>
